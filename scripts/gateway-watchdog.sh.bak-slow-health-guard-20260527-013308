#!/usr/bin/env bash
# OpenClaw runtime guardian.
# Runs outside OpenClaw cron so it can recover gateway starvation, stale browser trees,
# and runaway app-server fanout even when the gateway scheduler is degraded.

set -u
PATH=/usr/bin:/usr/local/bin:/bin:/root/.local/bin:/root/.npm-global/bin:/root/bin:/root/.nix-profile/bin:/root/.local/share/pnpm:/root/.bun/bin:/snap/bin

GATEWAY_URL="${GATEWAY_URL:-http://127.0.0.1:18789}"
GATEWAY_UNIT="${GATEWAY_UNIT:-openclaw-gateway.service}"
STATE_DIR="${STATE_DIR:-/root/.openclaw/workspace/logs/watchdog}"
LOCK_DIR="${LOCK_DIR:-/var/lock/openclaw}"
LOG_FILE="${STATE_DIR}/gateway-watchdog.log"
FAIL_FILE="${STATE_DIR}/gateway-watchdog.failures"
DEGRADED_FILE="${STATE_DIR}/gateway-watchdog.degraded"
LAST_RESTART_FILE="${STATE_DIR}/gateway-watchdog.last-restart"
LOCK_FILE="${LOCK_DIR}/gateway-watchdog.lock"

HEALTH_TIMEOUT_SECONDS="${HEALTH_TIMEOUT_SECONDS:-6}"
RESTART_COOLDOWN_SECONDS="${RESTART_COOLDOWN_SECONDS:-240}"
HEALTH_FAILURES_BEFORE_RESTART="${HEALTH_FAILURES_BEFORE_RESTART:-2}"
DEGRADED_CHECKS_BEFORE_RESTART="${DEGRADED_CHECKS_BEFORE_RESTART:-2}"
SLOW_HEALTH_MS="${SLOW_HEALTH_MS:-3000}"
GATEWAY_RSS_RESTART_KB="${GATEWAY_RSS_RESTART_KB:-2800000}"
CODEX_APP_SERVER_RESTART_COUNT="${CODEX_APP_SERVER_RESTART_COUNT:-10}"
CHROME_COUNT_LIMIT="${CHROME_COUNT_LIMIT:-16}"
CHROME_RSS_LIMIT_KB="${CHROME_RSS_LIMIT_KB:-1800000}"

mkdir -p "$STATE_DIR" "$LOCK_DIR"
exec 9>"$LOCK_FILE"
flock -n 9 || exit 0

now_ts() { date -Is; }
log() { printf '%s %s\n' "$(now_ts)" "$*" >> "$LOG_FILE"; }
read_count() { [ -f "$1" ] && tr -dc '0-9' < "$1" || printf '0'; }
write_count() { printf '%s\n' "$2" > "$1"; }

sum_rss_for_pattern() {
  local pattern="$1"
  pgrep -f "$pattern" 2>/dev/null | xargs -r ps -o rss= -p 2>/dev/null | awk '{s += $1} END {print s + 0}'
}

count_for_pattern() {
  pgrep -fc "$1" 2>/dev/null || true
}

gateway_pid() {
  pgrep -f '/usr/lib/node_modules/openclaw/dist/index.js gateway --port 18789' 2>/dev/null | head -1
}

health_probe() {
  local tmp code total_ms total_raw
  tmp=$(mktemp)
  total_raw=$(curl -sS -o "$tmp" -w '%{http_code} %{time_total}' --max-time "$HEALTH_TIMEOUT_SECONDS" "${GATEWAY_URL}/health" 2>/dev/null || printf '000 99')
  rm -f "$tmp"
  code=$(printf '%s' "$total_raw" | awk '{print $1}')
  total_ms=$(printf '%s' "$total_raw" | awk '{printf "%d", ($2 * 1000)}')
  printf '%s %s\n' "$code" "$total_ms"
}

restart_gateway() {
  local reason="$1" now last elapsed
  now=$(date +%s)
  last=$(read_count "$LAST_RESTART_FILE")
  elapsed=$((now - last))
  if [ "$last" != "0" ] && [ "$elapsed" -lt "$RESTART_COOLDOWN_SECONDS" ]; then
    log "restart-suppressed cooldown=${elapsed}s reason=${reason}"
    return 0
  fi

  log "restart-gateway reason=${reason}"
  write_count "$LAST_RESTART_FILE" "$now"
  write_count "$FAIL_FILE" 0
  write_count "$DEGRADED_FILE" 0
  systemctl --user restart "$GATEWAY_UNIT"
  sleep 8
  local probe
  probe=$(health_probe)
  log "post-restart health=${probe}"
}

trim_linkedin_chrome_if_needed() {
  local count rss main_pid
  count=$(count_for_pattern '/opt/google/chrome/chrome')
  rss=$(sum_rss_for_pattern '/opt/google/chrome/chrome')
  if [ "$count" -le "$CHROME_COUNT_LIMIT" ] && [ "$rss" -le "$CHROME_RSS_LIMIT_KB" ]; then
    return 0
  fi

  main_pid=$(pgrep -f '/opt/google/chrome/chrome.*--user-data-dir=/root/.openclaw/browser/linkedin-login-cdp' 2>/dev/null | head -1 || true)
  if [ -z "$main_pid" ]; then
    log "chrome-high-no-linked-profile count=${count} rss_kb=${rss}"
    return 0
  fi

  log "chrome-trim term pid=${main_pid} count=${count} rss_kb=${rss}"
  pkill -TERM -P "$main_pid" 2>/dev/null || true
  kill -TERM "$main_pid" 2>/dev/null || true
  sleep 5

  if kill -0 "$main_pid" 2>/dev/null; then
    log "chrome-trim kill pid=${main_pid}"
    pkill -KILL -P "$main_pid" 2>/dev/null || true
    kill -KILL "$main_pid" 2>/dev/null || true
  fi
}

recent_starvation_signals() {
  journalctl --user -u "$GATEWAY_UNIT" --since '3 minutes ago' --no-pager 2>/dev/null \
    | grep -Ec 'event_loop_delay|event_loop_utilization|fetch-timeout|handshake timeout|sessions\.list [1-9][0-9]{4,}ms|node\.list [1-9][0-9]{4,}ms|stalled session' || true
}

main() {
  trim_linkedin_chrome_if_needed

  local pid code health_ms fail_count degraded_count rss_kb etimes app_count signals reason restart_reason probe
  pid=$(gateway_pid || true)
  probe=$(health_probe)
  code=$(printf '%s' "$probe" | awk '{print $1}')
  health_ms=$(printf '%s' "$probe" | awk '{print $2}')

  if [ -z "$pid" ] || [ "$code" != "200" ]; then
    fail_count=$(read_count "$FAIL_FILE")
    fail_count=$((fail_count + 1))
    write_count "$FAIL_FILE" "$fail_count"
    app_count=$(count_for_pattern 'codex app-server --listen stdio://')
    log "health-fail count=${fail_count} pid=${pid:-none} http=${code} ms=${health_ms} app_servers=${app_count}"
    if [ "$fail_count" -ge "$HEALTH_FAILURES_BEFORE_RESTART" ]; then
      if [ "$app_count" -gt 0 ]; then
        log "restart-deferred reason=health-failures:${fail_count}:http-${code} active_app_servers=${app_count}"
        exit 0
      fi
      restart_gateway "health-failures:${fail_count}:http-${code}"
    fi
    exit 0
  fi

  write_count "$FAIL_FILE" 0
  rss_kb=$(ps -p "$pid" -o rss= 2>/dev/null | awk '{print $1 + 0}')
  etimes=$(ps -p "$pid" -o etimes= 2>/dev/null | awk '{print $1 + 0}')
  app_count=$(count_for_pattern 'codex app-server --listen stdio://')
  signals=$(recent_starvation_signals)

  reason=""
  restart_reason=""
  if [ "$health_ms" -ge "$SLOW_HEALTH_MS" ]; then
    reason="${reason}slow-health-${health_ms}ms,"
    restart_reason="${restart_reason}slow-health-${health_ms}ms,"
  fi
  if [ "$signals" -ge 3 ]; then
    reason="${reason}starvation-signals-${signals},"
  fi
  if [ "$rss_kb" -ge "$GATEWAY_RSS_RESTART_KB" ] && [ "$etimes" -ge 300 ]; then
    reason="${reason}gateway-rss-${rss_kb}kb,"
    restart_reason="${restart_reason}gateway-rss-${rss_kb}kb,"
  fi
  if [ "$app_count" -ge "$CODEX_APP_SERVER_RESTART_COUNT" ]; then
    reason="${reason}app-server-count-${app_count},"
    restart_reason="${restart_reason}app-server-count-${app_count},"
  fi

  if [ -n "$restart_reason" ]; then
    degraded_count=$(read_count "$DEGRADED_FILE")
    degraded_count=$((degraded_count + 1))
    write_count "$DEGRADED_FILE" "$degraded_count"
    log "degraded count=${degraded_count} reason=${reason} pid=${pid} rss_kb=${rss_kb} app_servers=${app_count} health_ms=${health_ms} signals=${signals}"
    if [ "$degraded_count" -ge "$DEGRADED_CHECKS_BEFORE_RESTART" ]; then
      restart_gateway "degraded:${restart_reason}"
    fi
    exit 0
  fi

  if [ -n "$reason" ]; then
    log "observed reason=${reason} pid=${pid} rss_kb=${rss_kb} app_servers=${app_count} health_ms=${health_ms} signals=${signals}"
    write_count "$DEGRADED_FILE" 0
    exit 0
  fi

  if [ "$(read_count "$DEGRADED_FILE")" != "0" ]; then
    log "recovered pid=${pid} rss_kb=${rss_kb} app_servers=${app_count} health_ms=${health_ms} signals=${signals}"
  fi
  write_count "$DEGRADED_FILE" 0
}

main "$@"
