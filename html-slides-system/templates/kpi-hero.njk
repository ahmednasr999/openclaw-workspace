<section class="slide slide-kpi slide-kpi--executive-split">
  <div class="kpi-split__metric-panel">
    <div class="kpi-split__metric">{{ metric }}</div>
    <div class="kpi-split__label">{{ metricLabel }}</div>
  </div>
  <div class="kpi-split__brief">
    <h1 class="slide-title kpi-split__title">{{ title }}</h1>
    {% if supportingText %}<p class="kpi-split__statement">{{ supportingText }}</p>{% endif %}
  </div>
  {% if footnote %}<div class="footnote kpi-split__footnote">{{ footnote }}</div>{% endif %}
</section>
