# Safe Gmail Watch Webhook scaffold.
# Disabled by default. Populate /root/.config/openclaw-gmail-watch.env with
# environment-backed secrets before enabling. No inline tokens are allowed here.
[Unit]
Description=Gmail Watch Webhook (safe SecretRef/env scaffold)
After=network-online.target

[Service]
Type=simple
EnvironmentFile=-/root/.config/openclaw-gmail-watch.env
Environment=PATH=/usr/local/bin:/usr/bin:/bin:/root/.nvm/versions/node/v22.22.0/bin
ExecStart=/root/.openclaw/workspace/scripts/gog-gmail-watch-safe.sh
Restart=on-failure
RestartSec=30

[Install]
WantedBy=default.target
