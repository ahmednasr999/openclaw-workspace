#!/usr/bin/env bash
set -u

python3 scripts/check-high-risk-skill-promotion.py --staged || exit 1
python3 scripts/pre_commit_hook.py || exit 1

STAGED_SCRIPTS=$(git diff --cached --name-only --diff-filter=ACM | sed -n '/^scripts\//p')
if [ -n "$STAGED_SCRIPTS" ]; then
  echo "Running repository preflight because scripts are staged..."
  bash scripts/preflight-test.sh || exit 1
fi

echo "Pre-commit checks passed"
